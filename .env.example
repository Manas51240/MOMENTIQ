# ==============================================================================
# MOMENTIQ — Environment Configuration Template
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cryptographic Session & Secret Configuration
# Required in production: Minimum 64-char cryptographically random secret
SESSION_SECRET=momentiq_super_secret_session_key_production_grade_minimum_64_characters_long_entropy_secure

# Google Gemini API Key for Server-Side AI Event Generation
# Obtain your key at: https://aistudio.google.com/
# Server-side only: NEVER exposed to client bundles
GEMINI_API_KEY=your_gemini_api_key_here

# Redis URL for Distributed Rate Limiting & Background Task Queues (Optional in dev)
# If omitted in dev/test, MOMENTIQ falls back to an in-memory sliding token bucket store
# REDIS_URL=redis://default:password@localhost:6379

# Database Configuration (PostgreSQL / SQLite Connection URL)
# For zero-config local dev & instant testing, defaults to embedded relational storage:
DATABASE_URL=file:./dev.db

